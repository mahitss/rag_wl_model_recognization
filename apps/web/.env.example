# Frontend environment variables for WonderLearn.
# Copy to .env.local for local overrides; never commit .env.local.
# Prefix VITE_ so Vite exposes them to client code.

# Backend API origin. When unset, the Vite dev server proxies /api to
# http://127.0.0.1:8000. In production, set this to the public API origin
# if the frontend and API are not served from the same host.
VITE_API_URL=
