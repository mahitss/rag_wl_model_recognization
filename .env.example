# Optional local settings. Defaults work when commands are run from the repository root.
WL_DATABASE_PATH=data/local/wonderlearn.sqlite3
WL_BACKUP_DIRECTORY=backups
WL_BACKUP_RETENTION_COUNT=30
WL_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
WL_MAX_UPLOAD_BYTES=10485760
WL_MAX_IMAGE_UPLOAD_BYTES=10485760
WL_MAX_IMAGE_DIMENSION=4096
WL_MAX_IMAGE_PIXELS=16000000
WL_MAX_PDF_PAGES=250
WL_MAX_EXTRACTED_CHARS=5000000
WL_CHUNK_SIZE_CHARS=2000
WL_CHUNK_OVERLAP_CHARS=200
WL_MAX_RETRIEVAL_RESULTS=10
WL_RETRIEVAL_MODE=lexical
WL_EMBEDDING_MODEL_ID=BAAI/bge-small-en-v1.5
WL_EMBEDDING_MODEL_REVISION=c32e6154d1bb7a0e47c5e745fd895e7700f44385
WL_EMBEDDING_DIMENSIONS=384
WL_EMBEDDING_BATCH_SIZE=32
WL_EMBEDDING_CACHE_PATH=artifacts/embedding-models
WL_LEXICAL_CANDIDATE_LIMIT=50
WL_SEMANTIC_CANDIDATE_LIMIT=50
WL_RRF_K=60
WL_SEMANTIC_MIN_SIMILARITY=0.60
# Optional loopback-only OpenAI-compatible local tutor server; leave blank to disable generation.
WL_TUTOR_BASE_URL=
WL_TUTOR_MODEL_ID=local-model
WL_TUTOR_TIMEOUT_SECONDS=90
WL_TUTOR_MAX_TOKENS=700
# Authentication and security settings.
WL_ENVIRONMENT=development
WL_RATE_LIMIT_ENABLED=true
WL_RATE_LIMIT_REQUESTS_PER_MINUTE=60
WL_AUTH_RATE_LIMIT_REQUESTS_PER_MINUTE=10
WL_EXPENSIVE_RATE_LIMIT_REQUESTS_PER_MINUTE=10
WL_MAX_REQUEST_BODY_BYTES=12582912
WL_SESSION_TTL_SECONDS=2592000
WL_DIAGNOSTICS_TOKEN=
WL_ANALYTICS_ENABLED=true
WL_PRODUCT_ANALYTICS_RETENTION_DAYS=90
