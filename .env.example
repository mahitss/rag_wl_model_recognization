WL_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
WL_MAX_UPLOAD_BYTES=10485760
WL_MAX_PDF_PAGES=250
WL_MAX_EXTRACTED_CHARS=5000000
WL_CHUNK_SIZE_CHARS=2000
WL_CHUNK_OVERLAP_CHARS=200
WL_MAX_RETRIEVAL_RESULTS=10
WL_RETRIEVAL_MODE=lexical
WL_EMBEDDING_MODEL_ID=BAAI/bge-small-en-v1.5
WL_EMBEDDING_MODEL_REVISION=c32e6154d1bb7a0e47c5e745fd895e7700f44385
WL_EMBEDDING_DIMENSIONS=384
WL_EMBEDDING_BATCH_SIZE=32
WL_EMBEDDING_CACHE_PATH=artifacts/embedding-models
